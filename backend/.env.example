# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.

PORT=5000

# Lien de connexion MongoDB (Atlas ou local)
# Local : mongodb://127.0.0.1:27017/eventy
MONGO_URI=mongodb://127.0.0.1:27017/eventy

# Clé secrète pour signer les tokens JWT (une longue phrase au hasard)
JWT_SECRET=change-moi

# ----- Emails (codes de vérification) avec Brevo -----
# Sans BREVO_API_KEY, en développement, les emails s'affichent dans le terminal au lieu d'être envoyés.
# En production (NODE_ENV=production), la clé est obligatoire.
BREVO_API_KEY=
# Adresse d'expéditeur validée dans Brevo (Senders, domains & dedicated IPs > Senders)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Eventy

# development en local, production sur l'hébergeur
NODE_ENV=development
