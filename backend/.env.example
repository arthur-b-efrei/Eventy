# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.

PORT=5000

# Lien de connexion MongoDB (Atlas ou local)
# Local : mongodb://127.0.0.1:27017/eventy
MONGO_URI=mongodb://127.0.0.1:27017/eventy

# Clé secrète pour signer les tokens JWT (une longue phrase au hasard)
JWT_SECRET=change-moi
